diff -ruN -x node_modules -x .next -x tsconfig.tsbuildinfo -x phase1 pa/src/features/game/GameRulesView.tsx pb/src/features/game/GameRulesView.tsx
--- pa/src/features/game/GameRulesView.tsx	1970-01-01 00:00:00.000000000 +0000
