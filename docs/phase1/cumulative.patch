--- pa/src/features/wars/BattleContractsView.tsx	1970-01-01 00:00:00.000000000 +0000
+++ pb/src/features/wars/BattleContractsView.tsx	2026-11-13 11:41:07.550193683 +0000
@@ -0,0 +1,59 @@
+import Link from "next/link";
+import { Money, Flag, StatusBadge } from "@/features/entities/entities";
+import { countryName, type Display } from "@/features/entities/display";
+import { DataView } from "@/features/explorer/DataView";
+import { MercenaryList } from "./MercenaryList";
+import type { Messages } from "@/i18n/messages";
+import { bountyOpen, bountyTotals, sortBounties, type BattleContracts } from "@/lib/domain/contracts";
+import { BountyCard, type BattleContext } from "./BountyCard";
+import s from "./contracts.module.css";
+
+const hasValue = (v: unknown) => v !== null && v !== undefined && !(typeof v === "object" && Object.keys(v as object).length === 0);
+
+/** Body of /battles/{id}/contracts. `battle` is the battle's own detail (for side names); null when it could not be loaded. */
+export function BattleContractsView({ battleId, contracts, battle, d, m }: { battleId: string; contracts: BattleContracts; battle: (BattleContext & { status?: string | null }) | null; d: Display; m: Messages }) {
+  const t = m.battleContracts, ct = m.contractsPage, nf = new Intl.NumberFormat(d.nl);
+  const sorted = sortBounties(contracts.bounties);
+  const open = sorted.filter(bountyOpen), closed = sorted.filter((b) => !bountyOpen(b));
+  const tot = bountyTotals(contracts.bounties);
+  const ctx: BattleContext | null = battle ? { ...battle, id: battleId } : null;
+  const empty = open.length === 0 && closed.length === 0 && contracts.auctions.length === 0 && !hasValue(contracts.myContract);
+  const side = (id: string | null | undefined) => id ? <span className={s.mini}><Flag id={id} d={d} /><b dir="auto">{countryName(id, d.dir)}</b></span> : <span>—</span>;
+  return (
+    <>
+      <p className={s.lead}>{t.intro}</p>
+      {battle ? (
+        <div className={`panel ${s.battleBar}`}>
+          {side(battle.attackerCountryId)}<span className={s.vs}>VS</span>{side(battle.defenderCountryId)}
+          {battle.type ? <StatusBadge value={battle.type} d={d} group="battleType" /> : null}
+          {battle.status ? <StatusBadge value={battle.status} d={d} /> : null}
+        </div>
+      ) : <p className={s.rules}>{t.unavailable}</p>}
+      <p className={s.rules}>
+        <Link href={`/battles/${encodeURIComponent(battleId)}`}>{t.back}</Link>
+        <Link href="/contracts">{t.allContracts}</Link>
+      </p>
+
+      {contracts.enabled === false ? <p className={s.empty}>{t.disabled}</p> : empty ? <p className={s.empty}>{t.none}</p> : (
+        <>
+          {open.length > 0 ? (
+            <div className={s.kpis}>
+              <div><b>{nf.format(tot.open)}</b><span>{t.offers}</span></div>
+              <div><b><Money value={tot.pool.toString()} d={d} /></b><span>{t.totalLeft}</span></div>
+              {tot.best !== null ? <div><b><Money value={tot.best.toString()} d={d} /></b><span>{t.bestPay}</span></div> : null}
+            </div>
+          ) : null}
+          {open.length > 0 ? <><h2 className={s.h2}>{t.bounties}</h2><div className={s.grid}>{open.map((b) => <BountyCard key={b.id} b={b} d={d} t={ct} context={ctx} linkToBattle={false} />)}</div></> : null}
+          {closed.length > 0 ? (
+            <details className={s.more}><summary>{t.inactive.replace("{n}", nf.format(closed.length))} · {t.showInactive}</summary>
+              <div className={s.grid} style={{ marginBlockStart: "0.8rem" }}>{closed.map((b) => <BountyCard key={b.id} b={b} d={d} t={ct} context={ctx} linkToBattle={false} />)}</div>
+            </details>
+          ) : null}
+          <MercenaryList title={t.auctions} items={contracts.auctions} d={d} m={m} />
+          {hasValue(contracts.myContract) ? <><h2 className={s.h2}>{t.myContract}</h2><p className={s.rules}>{t.myNote}</p><DataView data={contracts.myContract} section={null} detailLinks={false} labels={m.explorer} d={d} /></> : null}
+        </>
+      )}
+      {contracts.skipped > 0 ? <p className={s.rules}>{m.regionPage.c.skipped.replace("{n}", nf.format(contracts.skipped))}</p> : null}
+    </>
+  );
+}
diff -ruN -x node_modules -x .next -x tsconfig.tsbuildinfo -x phase1 pa/src/features/wars/BountyCard.tsx pb/src/features/wars/BountyCard.tsx
--- pa/src/features/wars/BountyCard.tsx	1970-01-01 00:00:00.000000000 +0000
+++ pb/src/features/wars/BountyCard.tsx	2026-11-11 07:03:00.999974696 +0000
@@ -0,0 +1,46 @@
+import Link from "next/link";
+import { countryName, type Display } from "@/features/entities/display";
+import { Flag, Money, RegionLink } from "@/features/entities/entities";
+import type { Messages } from "@/i18n/messages";
+import { remainingPercent, type Bounty } from "@/lib/domain/contracts";
+import s from "./contracts.module.css";
+
+const safe = (v: string) => /^[A-Za-z0-9_-]{1,80}$/.test(v);
+
+export interface BattleContext { id?: string | null; type?: string | null; regionId?: string | null; attackerCountryId?: string | null; defenderCountryId?: string | null }
+
+function Side({ id, paid, label, d }: { id: string | null | undefined; paid: boolean; label: string; d: Display }) {
+  return (
+    <div className={s.side} data-paid={paid}>
+      {id && <Flag id={id} d={d} />}
+      <span className={s.name} dir="auto">{id ? countryName(id, d.dir) : "—"}</span>
+      <span className={s.paid}>{paid ? label : ""}</span>
+    </div>
+  );
+}
+
+/** One bounty. Used by /contracts (battle comes from the bounty) and by a battle's own contracts page (`context` supplies the sides when the bounty has no `battle`). */
+export function BountyCard({ b, d, t, context, linkToBattle = true }: { b: Bounty; d: Display; t: Messages["contractsPage"]; context?: BattleContext | null; linkToBattle?: boolean }) {
+  const bt: BattleContext | null = b.battle ?? context ?? null;
+  const pct = remainingPercent(b);
+  const f = b.funder;
+  const fname = f?.name ?? (f?.type === "country" && f.id ? countryName(f.id, d.dir) : null);
+  return (
+    <article className={s.card}>
+      {linkToBattle && bt?.id && safe(bt.id) && <Link className={s.cover} href={`/battles/${encodeURIComponent(bt.id)}`} aria-label={fname ?? t.title} />}
+      <div className={s.top}><b>{bt?.regionId ? <RegionLink id={bt.regionId} d={d} link={false} /> : ""}</b><span>{bt?.type ? (d.m.t.battleType as Record<string, string>)[bt.type] ?? bt.type : ""}</span></div>
+      <div className={s.clash}>
+        <Side id={bt?.attackerCountryId} paid={b.side === "attacker"} label={t.forSide} d={d} />
+        <span className={s.vs}>VS</span>
+        <Side id={bt?.defenderCountryId} paid={b.side === "defender"} label={t.forSideD} d={d} />
+      </div>
+      <div className={s.pay}><b><Money value={b.perK} d={d} /></b><span>{t.per1k}</span></div>
+      {pct !== null && <div className={s.track} title={`${pct}%`}><i style={{ inlineSize: `${pct}%` }} /></div>}
+      <div className={s.foot}>
+        <span>{fname ? <>{t.fundedBy} <b dir="auto">{fname}</b></> : ""}</span>
+        <span><b><Money value={b.remaining} d={d} /></b> {t.left}</span>
+      </div>
+    </article>
+  );
+}
+export { s as contractStyles };
diff -ruN -x node_modules -x .next -x tsconfig.tsbuildinfo -x phase1 pa/src/features/wars/MercenaryList.tsx pb/src/features/wars/MercenaryList.tsx
--- pa/src/features/wars/MercenaryList.tsx	1970-01-01 00:00:00.000000000 +0000
+++ pb/src/features/wars/MercenaryList.tsx	2026-11-13 11:41:07.541600715 +0000
@@ -0,0 +1,47 @@
+import Link from "next/link";
+import type { Display } from "@/features/entities/display";
+import { Dt, Money, PlayerChip, StatusBadge } from "@/features/entities/entities";
+import { DataView } from "@/features/explorer/DataView";
+import type { Messages } from "@/i18n/messages";
+import { readMercenaryEntry } from "@/lib/domain/contracts";
+import s from "../regions/region.module.css";
+
+/** A titled list of mercenary auctions/contracts: a card with the recognised fields and the full entry under "Details". Renders nothing for an empty list. */
+export function MercenaryList({ title, items, d, m }: { title: string; items: unknown[]; d: Display; m: Messages }) {
+  if (items.length === 0) return null;
+  const t = m.mercenary, nf = new Intl.NumberFormat(d.nl);
+  return (
+    <section>
+      <h2 className={s.sec}>{title} · {nf.format(items.length)}</h2>
+      <p className={s.dim}>{t.note}</p>
+      <ul className={s.cards}>
+        {items.map((x, i) => {
+          const e = readMercenaryEntry(x);
+          return (
+            <li key={e.id ?? i} className={s.card}>
+              {e.recognised ? (
+                <>
+                  <div className={s.cardHead}>
+                    {e.side ? <span className={s.badge} data-tone={e.side === "attacker" ? "warn" : "ok"}>{e.side === "attacker" ? t.sideAttacker : e.side === "defender" ? t.sideDefender : e.side}</span> : <span />}
+                    {e.status ? <StatusBadge value={e.status} d={d} /> : null}
+                  </div>
+                  <dl className={s.facts}>
+                    {e.perK ? <><dt>{t.price}</dt><dd><Money value={e.perK} d={d} /></dd></> : null}
+                    {e.maxPerK ? <><dt>{t.maxPrice}</dt><dd><Money value={e.maxPerK} d={d} /></dd></> : null}
+                    {e.damageTarget != null ? <><dt>{t.target}</dt><dd>{nf.format(e.damageTarget)}</dd></> : null}
+                    {e.damageDone != null ? <><dt>{t.done}</dt><dd>{nf.format(e.damageDone)}</dd></> : null}
+                    {e.bidCount != null ? <><dt>{t.bids}</dt><dd>{nf.format(e.bidCount)}</dd></> : null}
+                    {e.endsAt ? <><dt>{t.ends}</dt><dd><Dt iso={e.endsAt} d={d} /></dd></> : null}
+                    {e.who ? <><dt>{t.by}</dt><dd>{e.who.id ? <PlayerChip id={e.who.id} name={e.who.name} avatar={null} d={d} /> : e.who.name}</dd></> : null}
+                  </dl>
+                  {e.battleId && /^[A-Za-z0-9_-]{1,80}$/.test(e.battleId) ? <Link href={`/battles/${encodeURIComponent(e.battleId)}`}>{t.openBattle}</Link> : null}
+                </>
+              ) : null}
+              <details><summary>{t.details}</summary><DataView data={x} section={null} detailLinks={false} labels={m.explorer} d={d} /></details>
+            </li>
+          );
+        })}
+      </ul>
+    </section>
+  );
+}
