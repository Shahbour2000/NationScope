+        {paper.subscribers != null ? <div><b>{nf.format(paper.subscribers)}</b><span>{t.subscribers}</span></div> : null}
+        {paper.articleCount != null ? <div><b>{nf.format(paper.articleCount)}</b><span>{t.articles}</span></div> : null}
