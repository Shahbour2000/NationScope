+++ pb/src/lib/domain/news-detail.ts	2026-11-13 06:44:29.542125066 +0000
@@ -0,0 +1,55 @@
+import { articleSchema, type Article } from "./world";
+import { asRecord, parseRows } from "./parse";
+
+/**
+ * GET /articles/{id} and /newspapers/{id}. Neither detail response has ever been captured; the article LIST row shape is real
+ * (tests/fixtures/real/articles.json). The detail is read as that same row plus whatever text/comments fields are present under common
+ * names. The article text format (plain, HTML or markup) is unknown, so it is shown as plain text and the page says so.
+ */
+const TEXT_KEYS = ["content", "body", "text", "html", "markdown"] as const;
+const ID = /^[A-Za-z0-9_-]{1,80}$/;
+
+/** Plain-text view of a text field that may contain simple HTML. Never produces markup. */
+export function plainText(s: string): string {
+  return s
+    .replace(/<\s*br\s*\/?>/gi, "\n").replace(/<\/\s*(p|div|h[1-6]|li|blockquote)\s*>/gi, "\n\n").replace(/<[^>]*>/g, "")
+    .replace(/&nbsp;/g, " ").replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&amp;/g, "&")
+    .replace(/\n{3,}/g, "\n\n").trim();
+}
+
+export interface ArticleComment { id: string | null; text: string; authorName: string | null; authorId: string | null; createdAt: string | null; score: number | null }
+export interface ArticleDetail { article: Article; paragraphs: string[]; hasBody: boolean; comments: ArticleComment[]; commentsUnread: number; extra: { visibility: string | null; tipsTotal: number | null } }
+
+export function parseArticleDetail(raw: unknown): ArticleDetail | null {
+  const base = articleSchema.safeParse(raw);
+  if (!base.success) return null;
+  const o = asRecord(raw);
+  const key = TEXT_KEYS.find((k) => typeof o[k] === "string" && (o[k] as string).trim().length > 0);
+  const paragraphs = key ? plainText(o[key] as string).split(/\n{2,}/).map((p) => p.trim()).filter(Boolean) : [];
+  const comments: ArticleComment[] = []; let commentsUnread = 0;
+  for (const c of Array.isArray(o.comments) ? o.comments : []) {
+    const r = asRecord(c), user = asRecord(r.author ?? r.user);
+    const text = [r.text, r.content, r.body].find((v) => typeof v === "string" && v.trim()) as string | undefined;
+    if (!text) { commentsUnread++; continue; }
+    const name = [r.authorName, r.username, user.username, user.name].find((v) => typeof v === "string") as string | undefined;
+    const id = [r.authorId, r.userId, user.id].find((v) => typeof v === "string" && ID.test(v as string)) as string | undefined;
+    comments.push({ id: typeof r.id === "string" ? r.id : null, text: plainText(text), authorName: name ?? null, authorId: id ?? null, createdAt: typeof r.createdAt === "string" ? r.createdAt : null, score: typeof r.score === "number" ? r.score : null });
+  }
+  return { article: base.data, paragraphs, hasBody: paragraphs.length > 0, comments, commentsUnread, extra: { visibility: typeof o.visibility === "string" ? o.visibility : null, tipsTotal: typeof o.tipsTotal === "number" ? o.tipsTotal : typeof o.tipsTotal === "string" && /^\d+$/.test(o.tipsTotal) ? Number(o.tipsTotal) : null } };
+}
+
+export interface NewspaperDetail { id: string; name: string | null; description: string | null; ownerId: string | null; ownerName: string | null; subscribers: number | null; articleCount: number | null; articles: Article[]; skipped: number }
+export function parseNewspaper(raw: unknown): NewspaperDetail | null {
+  const o = asRecord(raw);
+  if (typeof o.id !== "string" || !o.id) return null;
+  const owner = asRecord(o.owner ?? o.author);
+  const str = (...vs: unknown[]) => (vs.find((v) => typeof v === "string" && v.trim()) as string | undefined) ?? null;
+  const num = (...vs: unknown[]) => (vs.find((v) => typeof v === "number" && Number.isFinite(v)) as number | undefined) ?? null;
+  const list = [o.articles, o.items, o.recentArticles].find(Array.isArray);
+  const parsed = parseRows(list, articleSchema);
+  const ownerId = str(o.ownerId, o.authorId, owner.id);
+  return {
+    id: o.id, name: str(o.name, o.title), description: str(o.description, o.about), ownerId: ownerId && ID.test(ownerId) ? ownerId : null, ownerName: str(o.ownerName, o.authorName, owner.username, owner.name),
+    subscribers: num(o.subscribers, o.subscriberCount, o.subscribersCount), articleCount: num(o.articleCount, o.articlesCount) ?? (Array.isArray(list) ? list.length : null), articles: parsed.rows, skipped: parsed.skipped,
+  };
+}
diff -ruN -x node_modules -x .next -x tsconfig.tsbuildinfo -x phase1 pa/src/lib/domain/player-stats.ts pb/src/lib/domain/player-stats.ts
--- pa/src/lib/domain/player-stats.ts	1970-01-01 00:00:00.000000000 +0000
+++ pb/src/lib/domain/player-stats.ts	2026-11-12 10:45:16.287081387 +0000
@@ -0,0 +1,59 @@
+import { asRecord } from "./parse";
+
+/**
+ * GET /players/{id}/stats ("level, rank, damage, work and trade (all time, today, this week, this month) and what their companies are
+ * worth"). Only the top-level keys were captured (id, username, countryId, level, xp, prestige, rank, damage, work, trade, companies,
+ * joinedAt, serverTime); the nested shapes never were. Groups are therefore read by convention: an object whose keys look like periods
+ * becomes a period table, any other scalar becomes a labelled value, nested objects are flattened one level. Nothing is invented.
+ */
+export type PeriodKey = "all" | "day" | "week" | "month";
+export const PERIOD_ORDER: readonly PeriodKey[] = ["all", "month", "week", "day"];
+const PERIOD_ALIASES: Record<string, PeriodKey> = {
+  all: "all", total: "all", allTime: "all", lifetime: "all", day: "day", today: "day", daily: "day", week: "week", weekly: "week", thisWeek: "week", month: "month", monthly: "month", thisMonth: "month",
+};
+const DIGITS = /^\d+$/;
+export type Scalar = string | number;
+const scalar = (v: unknown): Scalar | null => (typeof v === "number" && Number.isFinite(v) ? v : typeof v === "string" && DIGITS.test(v) ? v : null);
+
+export interface MetricGroup { key: string; periods: Partial<Record<PeriodKey, Scalar>>; values: { key: string; value: Scalar }[] }
+
+/** Reads one group. Returns null when it holds no readable number at all. */
+export function readGroup(key: string, raw: unknown): MetricGroup | null {
+  const direct = scalar(raw);
+  if (direct !== null) return { key, periods: {}, values: [{ key, value: direct }] };
+  const o = asRecord(raw);
+  const periods: MetricGroup["periods"] = {}; const values: MetricGroup["values"] = [];
+  for (const [k, v] of Object.entries(o)) {
+    const p = PERIOD_ALIASES[k], sc = scalar(v);
+    if (p && sc !== null) periods[p] = sc;
+    else if (sc !== null) values.push({ key: k, value: sc });
+    else if (v && typeof v === "object" && !Array.isArray(v)) {
+      for (const [k2, v2] of Object.entries(v as Record<string, unknown>)) { const s2 = scalar(v2); if (s2 !== null) values.push({ key: `${k}.${k2}`, value: s2 }); }
+    }
+  }
+  return Object.keys(periods).length === 0 && values.length === 0 ? null : { key, periods, values };
+}
+
+export interface PlayerStats {
+  id: string; username: string | null; countryId: string | null; level: number | null; xp: number | null; prestige: number | null; rank: Scalar | null; joinedAt: string | null;
+  groups: MetricGroup[]; unreadGroups: string[];
+}
+const GROUP_KEYS = ["damage", "work", "trade", "companies"] as const;
+
+export function parsePlayerStats(raw: unknown): PlayerStats | null {
+  const o = asRecord(raw);
+  if (typeof o.id !== "string" || !o.id) return null;
+  const groups: MetricGroup[] = []; const unreadGroups: string[] = [];
+  for (const k of GROUP_KEYS) {
+    if (o[k] === undefined) continue;
+    const g = readGroup(k, o[k]);
+    if (g) groups.push(g); else unreadGroups.push(k);
+  }
+  const rank = o.rank;
+  return {
+    id: o.id, username: typeof o.username === "string" ? o.username : null, countryId: typeof o.countryId === "string" ? o.countryId : null,
+    level: typeof o.level === "number" ? o.level : null, xp: typeof o.xp === "number" ? o.xp : null, prestige: typeof o.prestige === "number" ? o.prestige : null,
+    rank: scalar(rank) ?? (typeof asRecord(rank).name === "string" ? (asRecord(rank).name as string) : typeof rank === "string" ? rank : null),
+    joinedAt: typeof o.joinedAt === "string" ? o.joinedAt : null, groups, unreadGroups,
+  };
+}
diff -ruN -x node_modules -x .next -x tsconfig.tsbuildinfo -x phase1 pa/src/lib/domain/ranking-archive.ts pb/src/lib/domain/ranking-archive.ts
--- pa/src/lib/domain/ranking-archive.ts	1970-01-01 00:00:00.000000000 +0000
+++ pb/src/lib/domain/ranking-archive.ts	2026-11-12 05:21:44.126268162 +0000
@@ -0,0 +1,43 @@
+import { asRecord } from "./parse";
+
+/**
+ * GET /rankings/{board}/archive: "finished periods of a leaderboard" (OpenAPI summary). No response has ever been captured, so this reads a
+ * list of period entries by convention: each entry is a period key string, or an object with `periodKey` (and optionally `period` and a
+ * timestamp). Unrecognised responses return null and the page shows them as returned.
+ */
+export type ArchivePeriod = "daily" | "weekly" | "monthly" | "other";
+export interface ArchiveEntry { periodKey: string; period: ArchivePeriod; at: string | null }
+const KEY = /^[A-Za-z0-9-]{1,20}$/;
+const TS_KEYS = ["archivedAt", "finishedAt", "endedAt", "closedAt", "endsAt"];
+
+/** The period type a key looks like; only the three formats the API's own keys follow are inferred, otherwise "other". */
+export function periodOfKey(key: string): ArchivePeriod {
+  if (/^\d{4}-\d{2}-\d{2}$/.test(key)) return "daily";
+  if (/^\d{4}-W\d{2}$/i.test(key)) return "weekly";
+  if (/^\d{4}-\d{2}$/.test(key)) return "monthly";
+  return "other";
+}
+
+export function readArchive(raw: unknown): { entries: ArchiveEntry[]; skipped: number } | null {
+  const o = asRecord(raw);
+  const list = Array.isArray(raw) ? raw : ["periods", "items", "archive", "rows", "data"].map((k) => o[k]).find(Array.isArray);
+  if (!Array.isArray(list)) return null;
+  const entries: ArchiveEntry[] = []; let skipped = 0;
+  for (const x of list) {
+    const e = asRecord(x);
+    const key = typeof x === "string" ? x : typeof e.periodKey === "string" ? e.periodKey : typeof e.key === "string" ? e.key : null;
+    if (!key || !KEY.test(key)) { skipped++; continue; }
+    const declared = typeof e.period === "string" && ["daily", "weekly", "monthly"].includes(e.period) ? (e.period as ArchivePeriod) : null;
+    const tk = TS_KEYS.find((k) => typeof e[k] === "string" && !Number.isNaN(Date.parse(e[k] as string)));
+    entries.push({ periodKey: key, period: declared ?? periodOfKey(key), at: tk ? (e[tk] as string) : null });
+  }
+  if (entries.length === 0 && skipped > 0) return null;
+  entries.sort((a, b) => b.periodKey.localeCompare(a.periodKey));
+  return { entries, skipped };
+}
+
+export function groupArchive(entries: readonly ArchiveEntry[]): Record<ArchivePeriod, ArchiveEntry[]> {
+  const g: Record<ArchivePeriod, ArchiveEntry[]> = { monthly: [], weekly: [], daily: [], other: [] };
+  for (const e of entries) g[e.period].push(e);
+  return g;
+}
diff -ruN -x node_modules -x .next -x tsconfig.tsbuildinfo -x phase1 pa/src/lib/domain/region-detail.ts pb/src/lib/domain/region-detail.ts
