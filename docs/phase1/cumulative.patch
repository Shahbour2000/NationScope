+import Link from "next/link";
+import { Dt, Flag, RegionLink, StatusBadge, CountryBadge } from "@/features/entities/entities";
+import { countryName, type Display } from "@/features/entities/display";
+import type { Messages } from "@/i18n/messages";
+import { campaignBattleSchema, campaignSummary, looseEvent, type Campaign, type CampaignBattle } from "@/lib/domain/region-detail";
+import s from "./region.module.css";
+
+const idOk = (v: string) => /^[A-Za-z0-9_-]{1,80}$/.test(v);
+
+function BattleRow({ b, regionId, d, m }: { b: CampaignBattle; regionId: string; d: Display; m: Messages }) {
+  const t = m.regionPage.b, running = b.status === "active" && !b.endedAt;
+  const side = (cid: string | null | undefined, win: boolean) => cid ? <span className={s.versus}><Flag id={cid} d={d} /><span data-win={win}>{countryName(cid, d.dir)}</span></span> : <span>—</span>;
+  const hasScore = b.attackerRounds != null && b.defenderRounds != null;
+  return (
+    <li>
+      {side(b.attackerCountryId, b.winner === "attacker")}
+      <span className={s.score} title={t.rounds}>{hasScore ? `${b.attackerRounds} – ${b.defenderRounds}` : "vs"}</span>
+      {side(b.defenderCountryId, b.winner === "defender")}
+      {b.type ? <StatusBadge value={b.type} d={d} group="battleType" /> : null}
+      {running ? <span className={s.badge} data-tone="warn">{t.running}</span> : null}
+      <span className={s.dim}>{b.startedAt ? <>{t.started} <Dt iso={b.startedAt} d={d} /></> : null}{b.endedAt ? <> · {t.ended} <Dt iso={b.endedAt} d={d} /></> : null}</span>
+      {b.sourceRegionId && b.sourceRegionId !== regionId ? <span className={s.dim}>{t.from} <RegionLink id={b.sourceRegionId} d={d} /></span> : null}
+      {b.sourceLost ? <span className={s.badge} data-tone="gold">{t.sourceLost}</span> : null}
+      {idOk(b.id) ? <Link href={`/battles/${encodeURIComponent(b.id)}`}>{t.openBattle}</Link> : null}
+    </li>
+  );
+}
+
+function LooseRow({ x, d, m }: { x: unknown; d: Display; m: Messages }) {
+  const e = looseEvent(x);
+  return (
+    <li>
+      {e.at ? <Dt iso={e.at} d={d} /> : null}
+      {e.countryIds.map((c) => <CountryBadge key={c} id={c} d={d} />)}
+      {e.regionIds.map((r) => <RegionLink key={r} id={r} d={d} />)}
+      {e.battleId && idOk(e.battleId) ? <Link href={`/battles/${encodeURIComponent(e.battleId)}`}>{m.regionPage.b.openBattle}</Link> : null}
+    </li>
+  );
+}
+
+/** Region campaign page body. Battles are fully typed (sample verified); `ownership` and `launchedFromHere` have never been captured populated, so they are read loosely and unreadable rows are only counted. */
+export function CampaignView({ campaign, regionId, d, m }: { campaign: Campaign; regionId: string; d: Display; m: Messages }) {
+  const t = m.regionPage.b, nf = new Intl.NumberFormat(d.nl);
+  const sum = campaignSummary(campaign.battles);
+  if (!campaign.shapeOk) return <p className={s.empty}>{t.shapeBad}</p>;
+  const launched = campaign.launched.map((x) => ({ x, p: campaignBattleSchema.safeParse(x) }));
+  const ownRows = campaign.ownership.map(looseEvent);
+  const unreadable = ownRows.filter((e) => !e.recognised).length + launched.filter((l) => !l.p.success && !looseEvent(l.x).recognised).length;
+  return (
+    <>
+      <p className={s.dim}>{t.intro}</p>
+      <div className={s.kpis}>
+        <div><b>{nf.format(sum.total)}</b><span>{t.total}</span></div>
+        <div><b>{nf.format(sum.active)}</b><span>{t.ongoing}</span></div>
+        <div><b>{nf.format(sum.heldByAttacker)}</b><span>{t.attackerWins}</span></div>
+        <div><b>{nf.format(sum.heldByDefender)}</b><span>{t.defenderWins}</span></div>
+        {sum.undecided > 0 ? <div><b>{nf.format(sum.undecided)}</b><span>{t.undecided}</span></div> : null}
+      </div>
+      {campaign.battles.length === 0 ? <p className={s.empty}>{t.none}</p> : <ul className={s.list}>{campaign.battles.map((b) => <BattleRow key={b.id} b={b} regionId={regionId} d={d} m={m} />)}</ul>}
+      {campaign.skipped > 0 ? <p className={s.dim}>{t.skipped.replace("{n}", nf.format(campaign.skipped))}</p> : null}
+
+      <h2 className={s.sec}>{t.ownership}</h2>
+      {ownRows.length === 0 ? <p className={s.empty}>{t.noOwnership}</p> : <ul className={s.list}>{campaign.ownership.map((x, i) => <LooseRow key={i} x={x} d={d} m={m} />)}</ul>}
+
+      <h2 className={s.sec}>{t.launched}</h2>
+      {launched.length === 0 ? <p className={s.empty}>{t.noLaunched}</p> : (
+        <ul className={s.list}>{launched.map((l, i) => l.p.success ? <BattleRow key={i} b={l.p.data} regionId={regionId} d={d} m={m} /> : <LooseRow key={i} x={l.x} d={d} m={m} />)}</ul>
+      )}
+      {unreadable > 0 ? <p className={s.dim}>{t.unreadable.replace("{n}", nf.format(unreadable))}</p> : null}
+    </>
+  );
+}
diff -ruN -x node_modules -x .next -x tsconfig.tsbuildinfo -x phase1 pa/src/features/regions/RegionCompaniesView.tsx pb/src/features/regions/RegionCompaniesView.tsx
--- pa/src/features/regions/RegionCompaniesView.tsx	1970-01-01 00:00:00.000000000 +0000
+++ pb/src/features/regions/RegionCompaniesView.tsx	2026-11-11 07:02:27.774674000 +0000
@@ -0,0 +1,74 @@
+import Link from "next/link";
+import { itemName, type Display } from "@/features/entities/display";
+import { ItemChip, PlayerChip } from "@/features/entities/entities";
+import type { Messages } from "@/i18n/messages";
+import { COMPANY_SORTS, companyTotals, fillPercent, filterSortCompanies, type CompanySort, type RegionCompany } from "@/lib/domain/region-detail";
+import s from "./region.module.css";
+
+const href = (base: string, item: string | null, sort: CompanySort) => {
+  const q = new URLSearchParams();
+  if (item) q.set("item", item);
+  if (sort !== "storage") q.set("sort", sort);
+  const str = q.toString();
+  return str ? `${base}?${str}` : base;
+};
+
+/** Companies built in one region: KPIs, product filter, sort, and a card per company. Filtering and sorting are plain links (no client JS). */
+export function RegionCompaniesView({ rows, skipped, item, sort, basePath, d, m }: { rows: RegionCompany[]; skipped: number; item: string | null; sort: CompanySort; basePath: string; d: Display; m: Messages }) {
+  const t = m.regionPage.c, nf = new Intl.NumberFormat(d.nl);
+  const all = companyTotals(rows);
+  const shown = filterSortCompanies(rows, item, sort);
+  const sortLabel: Record<CompanySort, string> = { storage: t.sortStorage, workers: t.sortWorkers, name: t.sortName };
+  if (rows.length === 0) return <><p className={s.empty}>{t.empty}</p>{skipped > 0 ? <p className={s.dim}>{t.skipped.replace("{n}", nf.format(skipped))}</p> : null}</>;
+  return (
+    <>
+      <div className={s.kpis}>
+        <div><b>{nf.format(all.companies)}</b><span>{t.total}</span></div>
+        <div><b>{nf.format(all.workers)}</b><span>{t.workers}</span></div>
+        <div><b>{nf.format(all.hiring)}</b><span>{t.hiring}</span></div>
+        <div><b>{nf.format(all.byItem.length)}</b><span>{t.products}</span></div>
+      </div>
+      {all.byItem.length > 1 ? (
+        <nav className={s.bar} aria-label={t.products}>
+          <span className={s.barLabel}>{t.products}</span>
+          <Link href={href(basePath, null, sort)} aria-current={item === null ? "true" : undefined}>{t.all}</Link>
+          {all.byItem.map((x) => <Link key={x.itemCode} href={href(basePath, x.itemCode, sort)} aria-current={item === x.itemCode ? "true" : undefined}>{itemName(x.itemCode, d)} · {nf.format(x.companies)}</Link>)}
+        </nav>
+      ) : null}
+      {all.companies > 1 ? (
+        <nav className={s.bar} aria-label={t.sortBy}>
+          <span className={s.barLabel}>{t.sortBy}</span>
+          {COMPANY_SORTS.map((k) => <Link key={k} href={href(basePath, item, k)} aria-current={sort === k ? "true" : undefined}>{sortLabel[k]}</Link>)}
+        </nav>
+      ) : null}
+      {shown.length === 0 ? <p className={s.empty}>{t.noMatch}</p> : (
+        <ul className={s.cards}>
+          {shown.map((c) => {
+            const pct = fillPercent(c.points, c.capacity), full = pct !== null && pct >= 100;
+            return (
+              <li key={c.id} className={s.card}>
+                <div className={s.cardHead}>
+                  <h3 title={c.name} dir="auto"><Link href={`/companies/${encodeURIComponent(c.id)}`}>{c.name}</Link></h3>
+                  <ItemChip code={c.itemCode} d={d} href={`/market/${encodeURIComponent(c.itemCode)}`} />
+                </div>
+                <div className={s.cardMeta}>
+                  {c.owner ? <PlayerChip id={c.owner.id} name={c.owner.username} avatar={c.owner.avatarUrl} d={d} /> : <span>{t.noOwner}</span>}
+                  {c.offer != null ? <span className={s.badge} data-tone="ok">{t.hiringBadge}</span> : null}
+                  {full ? <span className={s.badge} data-tone="gold">{t.storageFull}</span> : null}
+                </div>
+                <div>
+                  <div className={s.nums}><span>{t.stored}</span><b>{pct === null ? "—" : `${nf.format(Math.round(pct))}%`}</b></div>
+                  {pct !== null ? <div className={s.track} data-kind="store" data-full={full} role="img" aria-label={`${Math.round(pct)}%`}><i style={{ inlineSize: `${pct}%` }} /></div> : null}
+                  {c.points && c.capacity ? <div className={s.dim}>{nf.format(BigInt(c.points))} / {nf.format(BigInt(c.capacity))}</div> : null}
+                </div>
+                <div className={s.nums}><span>{t.workers}</span><b>{c.workers == null ? "—" : c.workers === 0 ? t.noWorkers : nf.format(c.workers)}</b></div>
+              </li>
+            );
+          })}
+        </ul>
+      )}
+      <p className={s.dim}>{t.capacityNote}</p>
+      {skipped > 0 ? <p className={s.dim}>{t.skipped.replace("{n}", nf.format(skipped))}</p> : null}
+    </>
+  );
+}
diff -ruN -x node_modules -x .next -x tsconfig.tsbuildinfo -x phase1 pa/src/features/regions/RegionHeader.tsx pb/src/features/regions/RegionHeader.tsx
--- pa/src/features/regions/RegionHeader.tsx	1970-01-01 00:00:00.000000000 +0000
+++ pb/src/features/regions/RegionHeader.tsx	2026-11-11 07:01:31.811541943 +0000
@@ -0,0 +1,55 @@
+import Link from "next/link";
+import { Icon } from "@/components/Icon";
+import { ProfileHeader } from "@/components/ProfileHeader";
+import { Tabs } from "@/components/Tabs";
+import type { Display } from "@/features/entities/display";
+import { CountryBadge, Flag } from "@/features/entities/entities";
+import type { Messages } from "@/i18n/messages";
+import { regionName } from "@/lib/domain/directory";
+import type { RegionDetail } from "@/lib/domain/region-detail";
+import s from "./region.module.css";
+
+export type RegionTab = "overview" | "companies" | "battles";
+const nfOf = (d: Display) => new Intl.NumberFormat(d.nl);
+
+/** Identity header + section tabs shared by the three region pages. `region` may be null when only the id is known. */
+export function RegionHeader({ id, region, current, d, m }: { id: string; region: RegionDetail | null; current: RegionTab; d: Display; m: Messages }) {
+  const t = m.regionPage, nf = nfOf(d);
+  const name = region?.name?.trim() || regionName(id, d.dir);
+  const base = `/regions/${encodeURIComponent(id)}`;
+  const num = (v: number | null | undefined) => (v == null ? "—" : nf.format(v));
+  const badges = region ? (
+    <>
+      {region.isCapital ? <span className={s.badge} data-tone="gold">{t.capital}</span> : null}
+      {region.occupied ? <span className={s.badge} data-tone="warn">{t.occupied}</span> : null}
+      {region.hasCoast != null ? <span className={s.badge}>{region.hasCoast ? t.coastal : t.inland}</span> : null}
+    </>
+  ) : null;
+  const kicker = region ? (
+    <>
+      {region.countryId ? <><span>{t.heldBy}</span><CountryBadge id={region.countryId} d={d} /></> : null}
+      {region.occupied && region.coreCountryId ? <><span>{t.coreOf}</span><CountryBadge id={region.coreCountryId} d={d} /></> : null}
+    </>
+  ) : null;
+  const stats = region ? [
+    { label: t.development, value: num(region.development) },
+    { label: t.residents, value: num(region.residents) },
+    { label: t.present, value: num(region.present) },
+    { label: t.companies, value: num(region.companies) },
+  ] : undefined;
+  const tabs = [
+    { href: base, label: t.tabOverview, current: current === "overview" },
+    { href: `${base}/companies`, label: t.tabCompanies, current: current === "companies", count: region?.companies ?? null },
+    { href: `${base}/campaign`, label: t.tabBattles, current: current === "battles" },
+  ];
+  return (
+    <>
+      <Link className={s.back} href="/regions"><Icon name="chevron" size={14} />{t.back}</Link>
+      <ProfileHeader
+        image={region?.countryId ? <span className={s.flagBox}><Flag id={region.countryId} d={d} /></span> : <span className="phead-fallback"><Icon name="map" size={32} /></span>}
+        kicker={kicker} title={name} badges={badges} stats={stats} statsLabel={t.stats}
+      />
+      <Tabs items={tabs} label={t.tabsLabel} />
+    </>
+  );
+}
diff -ruN -x node_modules -x .next -x tsconfig.tsbuildinfo -x phase1 pa/src/features/regions/RegionOverview.tsx pb/src/features/regions/RegionOverview.tsx
--- pa/src/features/regions/RegionOverview.tsx	1970-01-01 00:00:00.000000000 +0000
+++ pb/src/features/regions/RegionOverview.tsx	2026-11-11 07:01:31.818783159 +0000
@@ -0,0 +1,91 @@
+import Link from "next/link";
+import { Dt, ItemChip, Flag, RegionLink } from "@/features/entities/entities";
+import { countryName, type Display } from "@/features/entities/display";
+import type { Messages } from "@/i18n/messages";
+import { formatDuration, humanizeCode } from "@/lib/format";
+import { battleIdOf, facilitiesOf, type RegionDetail } from "@/lib/domain/region-detail";
+import s from "./region.module.css";
+
+const idOk = (v: string) => /^[A-Za-z0-9_-]{1,80}$/.test(v);
+
+/** Purpose-built region profile body. Pure: everything it shows comes from `region` (GET /regions/{id}); nothing is computed beyond percentages and time left. */
+export function RegionOverview({ region, d, m, nowMs }: { region: RegionDetail; d: Display; m: Messages; nowMs: number }) {
+  const t = m.regionPage, nf = new Intl.NumberFormat(d.nl);
+  const dep = region.deposit?.type ? region.deposit : null;
+  const depLeft = dep?.endsAt ? Date.parse(dep.endsAt) - nowMs : null;
+  const fac = facilitiesOf(region.upgrades), unread = (region.upgrades?.length ?? 0) - fac.length;
+  const battleId = battleIdOf(region.battle);
+  const occupied = region.occupied === true;
+  const res = region.resistance ?? null, resMax = region.resistanceMax ?? null;
+  const resPct = res !== null && resMax ? Math.max(0, Math.min(100, (res / resMax) * 100)) : null;
+  const facName = (code: string) => (t.facility as Record<string, string>)[code] ?? humanizeCode(code);
+  const neighbours = region.neighbors ?? [];
+  return (
+    <div className={s.grid}>
+      <section className={`panel ${s.panel}`}>
+        <h2>{t.stats}</h2>
+        <dl className={s.facts}>
+          {region.mainCity ? <><dt>{t.mainCity}</dt><dd dir="auto">{region.mainCity}</dd></> : null}
+          {region.biome ? <><dt>{t.biome}</dt><dd>{humanizeCode(region.biome)}</dd></> : null}
+          {region.climate ? <><dt>{t.climate}</dt><dd>{humanizeCode(region.climate)}</dd></> : null}
+          <dt>{t.lastOwnership}</dt><dd>{region.lastOwnershipChangeAt ? <Dt iso={region.lastOwnershipChangeAt} d={d} /> : t.noneRecorded}</dd>
+          <dt>{t.lastBattle}</dt><dd>{region.lastBattleEndedAt ? <Dt iso={region.lastBattleEndedAt} d={d} /> : t.noneRecorded}</dd>
+        </dl>
+      </section>
+
+      <section className={`panel ${s.panel}`}>
+        <h2>{t.resistance}</h2>
+        {occupied && res !== null ? (
+          <>
+            <div className={s.bigNum}>{nf.format(res)}{resMax ? <small>{t.resistanceOf.replace("{max}", nf.format(resMax))}</small> : null}</div>
+            {resPct !== null ? <div className={s.track} role="img" aria-label={`${Math.round(resPct)}%`}><i style={{ inlineSize: `${resPct}%` }} /></div> : null}
+            <p className={s.note}>{t.resistanceNote}</p>
+          </>
+        ) : <p className={s.note}>{t.resistanceNone}</p>}
+      </section>
+
+      <section className={`panel ${s.panel}`}>
+        <h2>{t.deposit}</h2>
+        {dep ? (
+          <>
+            <div className={s.cardHead}><ItemChip code={dep.type as string} d={d} href={`/market/${encodeURIComponent(dep.type as string)}`} />{dep.bonusPercent != null ? <span className={s.bigNum}>+{nf.format(dep.bonusPercent)}%<small>{t.depositBonus}</small></span> : null}</div>
+            {depLeft !== null ? <p className={s.note}>{depLeft > 0 ? t.depositEnds.replace("{t}", formatDuration(depLeft, d.m.time)) : t.depositEnded}</p> : null}
+          </>
+        ) : <p className={s.note}>{t.depositNone}</p>}
+      </section>
+
+      <section className={`panel ${s.panel}`}>
+        <h2>{t.battle}</h2>
+        {battleId && idOk(battleId) ? <Link href={`/battles/${encodeURIComponent(battleId)}`}>{t.openBattle}</Link> : region.battle != null ? <p className={s.note}>{t.battle}</p> : <p className={s.note}>{t.noBattle}</p>}
+        <p className={s.note}><Link href={`/regions/${encodeURIComponent(region.id)}/campaign`}>{t.openBattles}</Link></p>
+      </section>
+
+      <section className={`panel ${s.panel} ${s.wide}`}>
+        <h2>{t.facilities}</h2>
+        {fac.length === 0 && unread <= 0 ? <p className={s.note}>{t.facilitiesNone}</p> : (
+          <ul className={s.rows}>
+            {fac.map((f, i) => (
+              <li key={`${f.code}-${i}`}>
+                <span><b>{facName(f.code)}</b> <span className={s.dim}>{t.level} {f.level ?? "—"}{f.maxLevel ? ` / ${f.maxLevel}` : ""}</span></span>
+                {f.status ? <span className={s.badge} data-tone={f.status === "active" ? "ok" : "gold"}>{f.status === "active" ? t.inUse : f.status === "pending" ? t.underConstruction : humanizeCode(f.status)}</span> : <span />}
+                {f.level !== null && f.maxLevel ? <span className={`${s.track} ${s.sub}`} data-kind="level" role="img" aria-label={`${f.level}/${f.maxLevel}`}><i style={{ inlineSize: `${Math.min(100, (f.level / f.maxLevel) * 100)}%` }} /></span> : null}
+              </li>
+            ))}
+          </ul>
+        )}
+        {unread > 0 ? <p className={s.note}>{t.facilitiesUnread.replace("{n}", nf.format(unread))}</p> : null}
+      </section>
+
+      <section className={`panel ${s.panel} ${s.wide}`}>
+        <h2>{t.neighbours}</h2>
+        {neighbours.length === 0 ? <p className={s.note}>{t.neighboursNone}</p> : (
+          <ul className={s.chips}>
+            {neighbours.map((n) => (
+              <li key={n.id}>{idOk(n.id) ? <Link href={`/regions/${encodeURIComponent(n.id)}`}>{n.countryId ? <Flag id={n.countryId} d={d} /> : null}<span dir="auto">{n.name?.trim() || <RegionLink id={n.id} d={d} link={false} />}</span>{n.countryId && n.countryId !== region.countryId ? <span className={s.dim}>{countryName(n.countryId, d.dir)}</span> : null}</Link> : null}</li>
+            ))}
+          </ul>
+        )}
+      </section>
+    </div>
+  );
+}
diff -ruN -x node_modules -x .next -x tsconfig.tsbuildinfo -x phase1 pa/src/features/regions/region.module.css pb/src/features/regions/region.module.css
--- pa/src/features/regions/region.module.css	1970-01-01 00:00:00.000000000 +0000
+++ pb/src/features/regions/region.module.css	2026-11-11 07:01:09.422276902 +0000
@@ -0,0 +1,56 @@
+.back { display: inline-flex; align-items: center; gap: 0.3rem; margin-block-end: 0.7rem; font-size: 0.85rem; color: var(--muted); text-decoration: none; }
+.back:hover { color: var(--brand-cyan, #19c8ff); }
+.flagBox :global(.cflag-img), .flagBox :global(.cflag) { inline-size: 4.2rem; block-size: 3.1rem; border-radius: 6px; box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.16); object-fit: cover; }
+.badge { display: inline-flex; align-items: center; padding: 0.12rem 0.6rem; border-radius: 999px; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.03em; border: 1px solid var(--line-strong); color: var(--muted); }
+.badge[data-tone="warn"] { color: #ffb4a0; border-color: rgba(255, 120, 90, 0.5); }
+.badge[data-tone="gold"] { color: #f5c542; border-color: rgba(245, 197, 66, 0.5); }
+.badge[data-tone="ok"] { color: #4ade80; border-color: rgba(74, 222, 128, 0.45); }
+.grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-block-end: 1rem; }
+.wide { grid-column: 1 / -1; }
+.panel h2 { font-size: 0.78rem; letter-spacing: 0.09em; text-transform: uppercase; color: var(--muted); margin: 0 0 0.7rem; font-weight: 700; }
+.facts { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.45rem 1rem; margin: 0; }
+.facts dt { color: var(--muted); font-size: 0.85rem; }
+.facts dd { margin: 0; font-weight: 600; min-inline-size: 0; overflow-wrap: anywhere; }
+.bigNum { font-size: 1.7rem; font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums; }
+.bigNum small { font-size: 0.85rem; font-weight: 500; color: var(--muted); margin-inline-start: 0.3rem; }
+.track { block-size: 0.6rem; border-radius: 999px; background: rgba(148, 163, 184, 0.16); overflow: hidden; margin-block: 0.5rem; }
+.track i { display: block; block-size: 100%; background: linear-gradient(90deg, #ff8a5a, #ff5a6e); }
+.track[data-kind="level"] i { background: linear-gradient(90deg, #8b5cf6, #19c8ff); }
+.track[data-kind="store"] i { background: linear-gradient(90deg, #19c8ff, #4ade80); }
