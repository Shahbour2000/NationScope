# Which Age of Nations environment to read. "main" is the default; "development" must be chosen explicitly.
NATIONSCOPE_API_ENV=main

# Origins only (no path). Both have built-in defaults (src/lib/config/environments.ts); override here if needed.
# Each environment uses only its own origin. There is NO fallback between environments.
AOW_MAIN_API_ORIGIN=https://app.ageofnations.world
AOW_DEV_API_ORIGIN=https://dev.ageofnations.world

# Confirmed for Main: https://app.ageofnations.world/api/v1/units returns data. Do not repeat it in the origin.
AOW_API_PATH_PREFIX=/api/v1

# Tuning (defaults shown). The upstream limit is 60 req/min per IP; keep a safety margin.
AOW_API_TIMEOUT_MS=8000
AOW_API_MAX_REQUESTS_PER_MINUTE=40
AOW_CACHE_TTL_MS=30000
AOW_STALE_MAX_AGE_MS=300000

# Guard: production builds refuse the development API unless this is "true".
NATIONSCOPE_ALLOW_DEV_API_IN_PRODUCTION=false

# Enables /diagnostics (API explorer and endpoint availability check). Keep false on public deployments.
NATIONSCOPE_DIAGNOSTICS=false
